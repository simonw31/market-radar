# Market Radar configuration. ./install.sh copies this file to .env and fills
# the network values and secrets for you. Never commit .env: it holds passwords.

# --- Network ----------------------------------------------------------------
# Address your BROWSER uses to reach the server (LAN IP, Tailscale IP or
# domain). It is baked into the web bundle: rebuild "web" after a change.
CONVEX_PUBLIC_URL=http://localhost:3210
CONVEX_SITE_URL=http://localhost:3211
APP_PUBLIC_URL=http://localhost:3100

# Who can reach ports 3100 / 3210 / 6791. The app has NO login:
#   0.0.0.0      → everyone on your network (home server behind a router)
#   127.0.0.1    → this machine only (VPS + SSH tunnel)
#   100.x.y.z    → your Tailscale IP (VPS, recommended)
BIND_ADDRESS=0.0.0.0

# --- Convex (self-hosted database) -------------------------------------------
# Generated by install.sh. Keep it secret: it protects the admin key.
# Set it BEFORE the first start (changing it later changes the admin key).
CONVEX_INSTANCE_NAME=market-radar
CONVEX_INSTANCE_SECRET=

# --- Local AI (Ollama) ---------------------------------------------------------
# ~3.4 GB download, ~5 GB of RAM while it runs.
OLLAMA_MODEL=qwen3.5:4b

# --- Email (optional) ------------------------------------------------------------
# Watch reports (digest of new offers). Job applications are NEVER sent
# automatically: each one needs your explicit confirmation in the app.
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail / Google Workspace: an "app password", not your account password.
SMTP_PASS=

# Read-only inbox watcher: links recruiters' replies to your applications.
# Empty values reuse the SMTP account (imap.gmail.com for Gmail).
INBOX_WATCH_ENABLED=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

TZ=Europe/Paris
